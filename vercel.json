{
  "version": 2,
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/deltarune",
      "destination": "/deltarune/index.html"
    },
    {
      "source": "/deltarune/",
      "destination": "/deltarune/index.html"
    },
    {
      "source": "/((?!api/)(?!deltarune/).*)",
      "destination": "/index.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
